{
  "name": "remit-to",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test module/*.test.ts world/*.test.ts",
    "test:live": "node --import tsx --test agent/live.test.ts",
    "demo": "node world/demo.ts",
    "score": "node world/score.ts",
    "render": "npx tsx world/render-docs.ts",
    "seed": "npx tsx agent/seed.ts && npx tsx agent/worker.ts",
    "agent": "npx tsx agent/worker.ts",
    "agent:watch": "npx tsx agent/worker.ts --watch",
    "provider": "npx tsx agent/mock-provider.ts",
    "runner": "npx tsx agent/runner.ts",
    "demo:crash": "npx tsx agent/runner.ts --once --crash-after-accept; npx tsx agent/runner.ts --once",
    "publish:local": "spacetime publish remit-to --server local --yes",
    "reset": "spacetime publish remit-to --server local --delete-data=always --yes && spacetime generate --lang typescript --out-dir ./bindings --module-path ./module"
  },
  "dependencies": {
    "spacetimedb": "2.13.*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2",
    "vite": "^6.4.5"
  }
}
